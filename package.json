{
  "name": "sistem-inventaris-sentosa-atk",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.4.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
