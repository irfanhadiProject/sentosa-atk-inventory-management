    "android:release": "cross-env APP_ENV=prod npx expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "android": "expo run:android",
    "test": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo",
